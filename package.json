{
  "name": "arcade-scoreboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:dev": "node scripts/dev.mjs",
    "app:smoke": "npm run build && node --disable-warning=ExperimentalWarning scripts/smoke.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.js\" \"electron/**/*.test.js\"",
    "dist:win": "bash scripts/build-win.sh",
    "dist:linux-dir": "npm run build && electron-builder --linux dir"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "vite": "^7.3.6",
    "zustand": "^4.5.5"
  },
  "description": "Tablica wyników klasy (Arcade Scoreboard) - aplikacja desktopowa",
  "author": "Arcade Scoreboard"
}
